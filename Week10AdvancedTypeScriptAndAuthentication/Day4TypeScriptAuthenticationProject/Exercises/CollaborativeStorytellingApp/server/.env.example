PORT=5000
JWT_SECRET=replace-with-a-long-random-string
# Signs the session cookie that holds the CSRF secret.
SESSION_SECRET=replace-with-another-long-random-string
NODE_ENV=development

# PostgreSQL is the normal store. Memory mode is only for an explicit local demo.
STORAGE_MODE=postgres
DATABASE_URL=postgresql://postgres:replace-with-password@127.0.0.1:5432/storytelling
