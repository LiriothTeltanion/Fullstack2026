# Set a random master signing value of at least 32 characters.
PORT=5000
JWT_SECRET=replace-with-a-long-random-master-signing-value
# Optional independent refresh signing value. A purpose-specific key is derived when empty.
JWT_REFRESH_SECRET=
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=604800
EMAIL_CONFIRMATION_MODE=local
NODE_ENV=development
