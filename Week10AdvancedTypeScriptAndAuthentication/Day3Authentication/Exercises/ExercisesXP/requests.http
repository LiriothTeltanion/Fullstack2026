### REST Client local practice sequence. Its cookie jar keeps both cookies.
@base = http://127.0.0.1:5000/api

### Register an artificial account
# @name registration
POST {{base}}/auth/register
Content-Type: application/json

{"username":"sample_writer","email":"writer@example.com","password":"Practice-Orchard-47"}

### Confirm locally using only this registration response
POST {{base}}/auth/confirm-email
Content-Type: application/json

{"token":"{{registration.response.body.$.developmentConfirmation.token}}"}

### Login sets access and refresh cookies
POST {{base}}/auth/login
Content-Type: application/json

{"username":"sample_writer","password":"Practice-Orchard-47"}

### Read the protected profile
GET {{base}}/auth/profile

### Refresh rotates the refresh cookie
POST {{base}}/auth/refresh
Content-Type: application/json

{}

### Preserve the protected users exercise
GET {{base}}/users

### Logout revokes the session and clears both cookies
POST {{base}}/auth/logout
Content-Type: application/json

{}
