{
  "name": "fullstack2026",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:baseline": "node tools/verify_eslint_baseline.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"Week*/**/*.{js,ts}\" \"eslint.config.js\" \"tools/verify_eslint_baseline.mjs\"",
    "format:check": "prettier --check \"Week*/**/*.{js,ts}\" \"eslint.config.js\" \"tools/verify_eslint_baseline.mjs\"",
    "test": "npm run test:js && npm run test:python",
    "dev": "python -m http.server 8000",
    "build": "python tools/nova_quality_gate.py --repo . --strict",
    "audit": "python tools/nova_ultimate.py --repo . --audit --no-open",
    "quality": "python tools/nova_quality_gate.py --repo . --strict",
    "syntax": "python tools/nova_quality_gate.py --repo . --syntax-only --strict",
    "catalogs:refresh": "python tools/refresh_structure_catalogs.py --repo . --write",
    "catalogs:check": "python tools/refresh_structure_catalogs.py --repo . --check",
    "intake": "python tools/learning_intake.py",
    "intake:check": "python tools/learning_intake.py validate",
    "verify:visuals": "python tools/validate_readme_visuals.py --repo .",
    "verify:titles": "python tools/validate_display_titles.py --repo .",
    "verify:structure": "python tools/validate_repository_structure.py --repo . && npm run catalogs:check && npm run verify:visuals && npm run verify:titles",
    "test:python": "python -m unittest discover -s tests/python -p \"test_*.py\" -v",
    "test:js": "node tools/run_node_tests.mjs .",
    "typecheck:anchor": "tsc -p \"Week5MiniProjectAndTypeScript/Day2IntroductionToTypeScriptAndKeyConcepts/DailyChallenge/UnionTypeValidator/tsconfig.json\" --noEmit",
    "readme:generate": "python tools/nova_ultimate.py --repo . --readmes all --apply --yes --skip-fixes --skip-npm --no-open"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
