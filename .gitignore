# Module: gitignore
# Purpose: Prevent temporary, build, and environment artifacts from polluting version control.
# Author: Kevin "Lirioth" Cusnir
# Date: 2025-02-15 | TZ: Asia/Jerusalem
# Notes: Comments in ENGLISH; emojis sparingly.

# Python cache directories
__pycache__/
*.py[cod]
*.pyo
.Python
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Virtual environments
.env
.venv/
venv/
env/
ENV/

# Node and frontend tooling
node_modules/
dist/
build/
.npm/
.next/
.nuxt/
.svelte-kit/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript build cache
*.tsbuildinfo

# Logs and coverage
*.log
*.tmp
coverage/
.coverage
htmlcov/

# Local data artifacts
*.sqlite3
*.sqlite
*.db
data/*.db
data/*.sqlite

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.bak
*.orig
*.rej

# Editor folders
.vscode/
.idea/
# Local tool state (reports are intentionally versionable)
.nova/

# Local secrets/configuration
.env
.env.*
!.env.example
**/config.js

# Private authenticated academy intake
.private/

# Redundant curriculum archives
Week*.zip
.nova-readme-backups/

# Local-only notes. They stay on Kevin's machines and are
# not published.
/AGENTS.md
/.ai/
/.github/copilot-instructions.md

# Local private context (never committed)
AGENTS.local.md
CLAUDE.local.md
*.local.md
.claude/settings.local.json

# Local planning notes, review records and generated reports. They stay on
# Kevin's machines and are not published (moved out of the index 2026-11-25).
/.github/INTERNAL_GUIDE.md
/.learning/OCTOPUS_INTAKE.md
/.learning/PROGRESS.md
/.learning/REVIEW_QUEUE.md
/.learning/evidence/
/.learning/sessions/
/reports/resume/
/reports/nova/NOVA_UPDATE_REPORT.md
/reports/nova/README.nova.generated.md
/reports/nova/next_actions.md
/reports/nova/nova_repo_audit.*
/reports/nova/nova_repo_dashboard.html
/reports/nova/SUMMARY.txt
/reports/nova/quality_report.*
/FINAL_README_INSTALL_REPORT.md
/NOVA_*.bat
/pyproject.nova.suggested.toml
/tools/nova_ultimate.py
/tests/python/test_nova_generator.py
